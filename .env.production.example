# Public deployment. Set a real DNS name before starting Caddy.
DOCMIND_SITE_ADDRESS=docmind.example.com
DOCMIND_BIND_ADDRESS=0.0.0.0
DOCMIND_HTTP_PORT=80
DOCMIND_HTTPS_PORT=443
DOCMIND_COOKIE_SECURE=true
DOCMIND_API_DOCS=false

POSTGRES_DB=docmind
POSTGRES_USER=docmind
POSTGRES_PASSWORD=replace-with-a-strong-random-password
DOCMIND_APP_DB_USER=docmind_app
DOCMIND_APP_DB_PASSWORD=replace-with-a-different-strong-random-password

# Keep the model service on a private network.
DOCMIND_OLLAMA_URL=http://ollama.internal:11434
DOCMIND_OLLAMA_MODEL=qwen2.5:1.5b

# Use a private S3 bucket and scoped credentials. Local uses the shared PDF volume.
DOCMIND_STORAGE_BACKEND=s3
DOCMIND_S3_BUCKET=docmind-documents
DOCMIND_S3_ENDPOINT=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional. Use the same version for both prebuilt images.
# DOCMIND_API_IMAGE=ghcr.io/zidaneidriss19/docmind-ai-api:v1.0.0
# DOCMIND_WEB_IMAGE=ghcr.io/zidaneidriss19/docmind-ai-web:v1.0.0
