{$DOCMIND_SITE_ADDRESS:http://:80} {
	encode zstd gzip
	log

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	@backend path /api/* /health /ready /docs /redoc /openapi.json
	handle @backend {
		request_body {
			max_size 22MB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
			Cache-Control "no-cache"
		}
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
